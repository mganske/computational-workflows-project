process {
    withName: 'TRIMGALORE' {
        cpus = 8
    }
}

process {
    withName: 'SALMON_QUANT' {
        ext.args = '--libType A'
    }
}

process {
    withName: 'PICARD_MARKDUPLICATES' {
        ext.prefix = { "${meta.id}.markdup" }
    }
}

process {
    withName: 'STRINGTIE_STRINGTIE' {
        ext.args = '--rf'
    }
}

process {
    withName: 'GFFREAD' {
        ext.args   = '-w'
        ext.prefix = 'transcriptome'
    }
}

params {
    hisat2_build_memory      = '200.GB'
}